{
  "name": "dsh-intranet-auto-continue",
  "version": "1.2.0",
  "description": "Continues a conversation after recoverable interruptions, with configurable retry limits.",
  "type": "module",
  "main": "plugin.js",
  "exports": {
    ".": "./plugin.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "plugin.js",
    "client.js"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.2.3",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "license": "MIT",
  "capability": {
    "title": "自动续跑",
    "description": "可恢复中断时按次数上限自动追加续跑消息，可暂停并查看记录。",
    "usage": {
      "steps": [
        "从能力中心安装并等待 DSH 激活。",
        "打开插件 → 自动续跑调整次数或查看记录。"
      ],
      "inputs": "DSH 会话事件",
      "output": "自动续跑记录",
      "example": "遇到可恢复的网络中断时自动续跑。"
    },
    "os": [
      "win32",
      "darwin",
      "linux"
    ],
    "arch": [
      "x64",
      "arm64"
    ]
  }
}
