{
  "name": "capability-center-drawio",
  "version": "0.2.0",
  "description": "Same-origin draw.io canvas with native chat, session-bound diagram tools, and offline assets",
  "type": "module",
  "main": "plugin.js",
  "exports": {
    ".": "./plugin.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "atomic.js",
    "index.js",
    "plugin.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "drawio",
    "drawio-provenance.json"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.2.3",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "license": "MIT",
  "capability": {
    "title": "draw.io 画布",
    "description": "在 DSH 会话中同源离线编辑 draw.io 图表，支持精确选区与结构更新。",
    "usage": {
      "steps": [
        "安装后在对话中让模型调用 drawio_create。",
        "在画布中框选图元并通过会话修改。"
      ],
      "inputs": "节点、连线、图元选区",
      "output": "会话绑定画板及修订",
      "example": "创建流程图并框选两个节点修改颜色。"
    },
    "os": [
      "win32",
      "darwin",
      "linux"
    ],
    "arch": [
      "x64",
      "arm64"
    ]
  }
}
