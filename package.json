{
  "name": "capability-center-workspace",
  "version": "0.2.12",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node --test --test-concurrency=1 tests/*.test.js",
    "dev": "exec node tools/dev.mjs",
    "dev:preview": "npm run build && node tools/preview.mjs",
    "publish:core": "node tools/publish.mjs core",
    "publish:catalog": "node tools/publish.mjs catalog",
    "typecheck": "tsc --noEmit",
    "dev:admin": "node --watch apps/admin/server.js",
    "start:admin": "node apps/admin/server.js",
    "test:registry": "node --test packages/protocol/test.js apps/admin/test.js tests/catalog-sync.test.js tests/runtime.test.js",
    "capability:validate": "node packages/capability-sdk/cli.js validate"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.18.3"
}
