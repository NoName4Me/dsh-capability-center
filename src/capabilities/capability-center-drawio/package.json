{
  "name": "capability-center-drawio",
  "version": "0.1.7",
  "description": "Same-origin draw.io canvas with native chat, session-bound diagram tools, and offline assets",
  "type": "module",
  "main": "plugin.js",
  "exports": {
    ".": "./plugin.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "atomic.js",
    "index.js",
    "plugin.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "drawio",
    "drawio-provenance.json"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.2.3",
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-tool"
      ]
    }
  },
  "license": "MIT"
}
